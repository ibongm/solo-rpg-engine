# ─────────────────────────────────────────────────────────────
# Solo RPG Engine — environment variables
# Copy to .env.local for local dev. In Vercel, add the same keys
# under Project → Settings → Environment Variables.
# See SETUP.md for step-by-step instructions.
# ─────────────────────────────────────────────────────────────

# ── Frontend (Vite — exposed to the browser) ─────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Backend (Vercel Serverless — never exposed to the browser) ─
GCP_PROJECT_ID=
# Vertex region. The Gemini 3.x/4 models in src/config/models.js are served from "global" (verified 2026-10-16).
GCP_LOCATION=global
# Base64-encoded OR raw stringified JSON service-account key.
GCP_SERVICE_ACCOUNT_KEY=

# ── Local development only (do NOT set these in Vercel production) ─
# Use the Firebase Emulator Suite instead of a real Firebase project.
# VITE_USE_EMULATORS=true
# VITE_FIREBASE_PROJECT_ID=demo-solo-rpg
# VITE_FIREBASE_API_KEY=demo-key
# VITE_FIREBASE_AUTH_DOMAIN=localhost
# VITE_FIREBASE_STORAGE_BUCKET=demo-solo-rpg.appspot.com
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# Return canned, schema-valid AI responses instead of calling Vertex AI.
# VERTEX_MOCK=1
