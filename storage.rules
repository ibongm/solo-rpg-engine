rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Scene paintings and portraits are written server-side by /api/paint-scene
    // (Admin SDK bypasses rules). Clients may only read their own files.
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
  }
}
